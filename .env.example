# Directories
OUTPUT_DIR=output
CACHE_DIR=cache
LOGS_DIR=logs

# FFmpeg
FFMPEG_PATH=ffmpeg
# Dedicated production build. Prefer a build with h264_nvenc; falls back to
# FFMPEG_PATH and then libx264 when NVENC cannot be validated.
VIDEO_FFMPEG_PATH=
FFPROBE_PATH=

# Local video production integrations
VIDEO_PRODUCTION_DIR=output/video_production
VIDEO_FACTORY_ROOT=
EDGE_TTS_PATH=
BLENDER_PATH=
AERENDER_PATH=

# Whisper
WHISPER_ENGINE=faster-whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh
# Platform override. auto lets Whisper detect English, Chinese, or other languages.
YOUTUBE_WHISPER_LANGUAGE=auto
DOUYIN_WHISPER_LANGUAGE=zh
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BATCH_SIZE=8
WHISPER_BEAM_SIZE=3
WHISPER_VAD_MIN_SILENCE_MS=700
WHISPER_MIN_FREE_VRAM_MB=4096
WHISPER_GPU_MAX_UTILIZATION=60
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1
WHISPER_GPU_FALLBACK=true
WHISPER_RELEASE_AFTER_JOB=true
# Optional directory containing cublas64_12.dll and cuDNN 9 DLLs.
WHISPER_CUDA_PATH=

# LLM, OpenAI-compatible. Leave empty to use local heuristic analysis.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT=120
LLM_MAX_CHARS=60000

# Optional override. Defaults to ~/.codex/skills/novel-writing.
NOVEL_WRITING_SKILL_PATH=
NATIVE_ENGLISH_REVIEW_SKILL_PATH=
NOVEL_REVIEW_MODEL=
ENGLISH_REVIEW_HARPER_CLI_PATH=

# Advanced NLP / semantic RAG / scene analysis
RAG_SEARCH_BACKEND=hybrid
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-small-zh-v1.5
SENTENCE_TRANSFORMER_BATCH_SIZE=32
# Keep local jobs from waiting on Hugging Face network retries.
SENTENCE_TRANSFORMER_LOCAL_ONLY=true
SPACY_MODEL=zh_core_web_sm
NLP_MAX_CHARS=120000
SCENE_DETECTION_ENABLED=true
SCENE_THRESHOLD=27.0
SCENE_MIN_SECONDS=0.6
SCENE_SAMPLE_SECONDS=2.0
SCENE_MAX_SAMPLES=900
SCENE_DOWNSCALE_WIDTH=640

# Local analytics warehouse
ANALYTICS_STORE_ENABLED=true
# Defaults to cache/analytics/content_research.duckdb
ANALYTICS_DB_PATH=

# Cover and key-image semantics
OPENCLIP_ENABLED=true
OPENCLIP_ALLOW_DOWNLOAD=false
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
OPENCLIP_DEVICE=auto
OPENCLIP_TOP_K=5
OPENCLIP_STORE_EMBEDDING=true
# Optional comma-separated English labels. Empty uses the built-in content labels.
OPENCLIP_LABELS=

# Audio rhythm features
AUDIO_RHYTHM_ENABLED=true
# auto uses native librosa below Python 3.13 and a fast compatible loader on 3.13+.
AUDIO_RHYTHM_BACKEND=auto
AUDIO_RHYTHM_SAMPLE_RATE=16000
AUDIO_RHYTHM_MAX_SECONDS=1800

# Persistent local task queue
JOB_WORKER_COUNT=1
JOB_QUEUE_CAPACITY=100
JOB_HISTORY_LIMIT=20
JOB_LOG_LIMIT=500
# Defaults to cache/jobs/jobs.sqlite3
JOB_DB_PATH=
# Defaults to state/creator_progress.sqlite3 (outside disposable cache/output)
CREATOR_PROGRESS_DB_PATH=

# Shared resource scheduler. GPU defaults to exclusive access so Whisper and
# OpenCLIP cannot occupy the same GPU concurrently.
RESOURCE_NETWORK_SLOTS=3
RESOURCE_CPU_HEAVY_SLOTS=2
RESOURCE_GPU_SLOTS=1
RESOURCE_REALTIME_AUDIO_SLOTS=1
RESOURCE_ACQUIRE_TIMEOUT=3600

# Windows WASAPI playback capture. A task must still opt in explicitly.
PLAYBACK_CAPTURE_ENABLED=true
PLAYBACK_CAPTURE_DEFAULT_SECONDS=300
PLAYBACK_CAPTURE_MAX_SECONDS=14400
PLAYBACK_CAPTURE_WARMUP_SECONDS=8
PLAYBACK_CAPTURE_OPEN_BROWSER=true
PLAYBACK_CAPTURE_SILENCE_THRESHOLD=0.001

# Platform cookies / yt-dlp
BILIBILI_COOKIE_FILE=
BILIBILI_COOKIES_FROM_BROWSER=
# B站媒体连接中断时保留 .part 文件并断点续传。
BILIBILI_DOWNLOAD_ATTEMPTS=2
BILIBILI_DOWNLOAD_RETRIES=8
BILIBILI_FRAGMENT_RETRIES=12
BILIBILI_SOCKET_TIMEOUT=30
BILIBILI_HTTP_CHUNK_SIZE=10485760
YOUTUBE_COOKIE_FILE=
YOUTUBE_COOKIES_FROM_BROWSER=
DOUYIN_COOKIE_FILE=
DOUYIN_COOKIES_FROM_BROWSER=
# Dedicated Douyin adapter for single videos and creator profiles.
DOUYIN_ADAPTER_ENABLED=true
DOUYIN_ADAPTER_ROOT=integrations/douyin-downloader
DOUYIN_ADAPTER_TIMEOUT=900
DOUYIN_AUTH_TIMEOUT=600
PLATFORM_AUTH_TIMEOUT=600
XIAOHONGSHU_COOKIE_FILE=
XIAOHONGSHU_COOKIES_FROM_BROWSER=
# Generic fallback for platforms without a platform-specific value.
YTDLP_COOKIE_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_PROXY=
BATCH_LIMIT=20
COMMENT_LIMIT=100
RAG_CHUNK_CHARS=900

# Set to 1 to bypass cache by default.
CONTENT_RESEARCH_OVERWRITE=0
